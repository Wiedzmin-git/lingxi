{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "GraphiteSoft",
  "id": "graphite-soft",
  "light": {
    "palette": {
      "neutral": "#f5f6f7",
      "ink": "#28323b",
      "primary": "#526b80",
      "success": "#397954",
      "warning": "#946b31",
      "error": "#a94747",
      "info": "#576d83",
      "interactive": "#426789",
      "diffAdd": "#397954",
      "diffDelete": "#a94747"
    },
    "v2Overrides": {
